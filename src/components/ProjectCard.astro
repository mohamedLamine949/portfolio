---
import { Image } from 'astro:assets';
import { CATEGORIES, type Projet } from '../lib/projets';

interface Props {
  projet: Projet;
  large?: boolean;
  delay?: number;
}

const { projet, large = false, delay = 0 } = Astro.props;
const { data } = projet;
const metric = data.metrics[0];
---
<a
  href={`/projets/${projet.id}`}
  class:list={['card', { large }]}
  data-category={data.category}
  data-reveal
  style={`--c: var(--cat-${data.category}); --d: ${delay}s`}
>
  <div class:list={['media', { illus: !data.cover }]}>
    {data.cover ? (
      <Image src={data.cover} alt={data.coverAlt ?? ''} widths={[480, 960, 1440]} sizes={large ? '(max-width: 900px) 100vw, 700px' : '(max-width: 900px) 100vw, 380px'} />
    ) : data.illustration ? (
      <Image src={data.illustration} alt="" />
    ) : null}
  </div>
  <div class="body">
    <div class="meta">
      <span class="cat">{CATEGORIES[data.category].cadre}</span>
      <span class="period mono">{data.period}</span>
    </div>
    <h3>{data.title}</h3>
    <p>{data.summary}</p>
    {metric && (
      <div class="metric"><strong>{metric.value}</strong> {metric.label}</div>
    )}
    <span class="more" aria-hidden="true">Lire la fiche →</span>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; box-shadow: var(--shadow);
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .card:hover { border-color: color-mix(in srgb, var(--c) 50%, var(--line)); box-shadow: 0 2px 4px rgba(14, 26, 43, .06), 0 14px 32px rgba(14, 26, 43, .1); }
  .media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-alt); border-bottom: 1px solid var(--line); }
  .media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  .card:hover .media img { transform: scale(1.035); }
  .media.illus { background: linear-gradient(160deg, color-mix(in srgb, var(--c) 9%, #fff), #f7f9fc); display: grid; place-items: center; padding: 26px 32px; }
  .media.illus img { object-fit: contain; }
  .body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
  .period { font-size: 12px; color: var(--muted); white-space: nowrap; }
  h3 { font-size: 18px; color: var(--ink); }
  p { margin: 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.6; }
  .metric { margin-top: auto; padding-top: 12px; font-size: 13.5px; color: var(--muted); border-top: 1px dashed var(--line); }
  .metric strong { color: var(--ink); font-size: 15px; }
  .more { font-size: 13.5px; font-weight: 600; color: var(--accent); }
  .metric + .more { margin-top: 0; }
  .body > p + .more { margin-top: auto; padding-top: 10px; }

  .large { display: grid; grid-template-columns: 1.3fr 1fr; }
  .large .media { aspect-ratio: auto; min-height: 360px; border-bottom: 0; border-right: 1px solid var(--line); }
  .large .media img { object-position: left center; }
  .large .body { padding: 36px; justify-content: center; gap: 12px; }
  .large h3 { font-size: 28px; }
  .large p { font-size: 15.5px; }
  @media (max-width: 900px) {
    .large { grid-template-columns: 1fr; }
    .large .media { min-height: 0; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--line); }
    .large .body { padding: 22px; }
    .large h3 { font-size: 22px; }
  }
</style>
