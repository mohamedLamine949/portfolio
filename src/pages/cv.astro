---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
// Aperçu rendu depuis job/cv/cv.html (Chrome headless, facteur 2,5) ; à régénérer avec le PDF.
import apercu from '../assets/cv/apercu-cv.png';

const PDF = '/CV_Mohamed_Lamine_KONE.pdf';
---
<Base
  title="Curriculum vitæ"
  description="CV de Mohamed Lamine Kone, ingénieur informatique (CY Tech, 2026) : chef de projet digital et consultant en transformation numérique. Aperçu en ligne et téléchargement au format PDF."
>
  <section class="head">
    <div class="wrap bar">
      <div>
        <p class="kicker rise">Curriculum vitæ</p>
        <h1 class="rise" style="--d:.06s">Mohamed Lamine Kone</h1>
        <p class="lead rise" style="--d:.12s">Ingénieur informatique · chef de projet digital et consultant en transformation numérique. Une page, mise à jour en octobre 2026.</p>
      </div>
      <div class="actions rise" style="--d:.18s">
        <a class="btn btn-primary" href={PDF} download="CV_Mohamed_Lamine_KONE.pdf">Télécharger le PDF</a>
        <a class="btn" href={PDF} target="_blank" rel="noopener">Ouvrir dans un nouvel onglet</a>
      </div>
    </div>
  </section>

  <section class="viewer">
    <div class="wrap">
      <a class="sheet rise" style="--d:.2s" href={PDF} target="_blank" rel="noopener" aria-label="Ouvrir le CV au format PDF">
        <Image
          src={apercu}
          alt="Aperçu du CV de Mohamed Lamine Kone : profil, expérience chez Sirius, ASR Groupe et BDR Booking, formation à CY Tech, compétences et langues."
          widths={[600, 900, 1240, 1985]}
          sizes="(max-width: 900px) 100vw, 860px"
          loading="eager"
        />
      </a>
      <p class="note">L'aperçu est une image ; le PDF contient du texte sélectionnable et des liens cliquables.</p>
    </div>
  </section>
</Base>

<style>
  .head { padding: 56px 0 32px; border-bottom: 1px solid var(--line); }
  .bar { display: flex; justify-content: space-between; align-items: end; gap: 28px; flex-wrap: wrap; }
  h1 { font-size: clamp(32px, 4.4vw, 48px); font-weight: 700; letter-spacing: -.02em; margin: 12px 0 10px; }
  .lead { color: var(--ink-2); margin: 0; max-width: 60ch; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .viewer { background: var(--bg-alt); padding: 48px 0 88px; }
  .sheet {
    display: block; max-width: 860px; margin: 0 auto; background: #fff;
    border: 1px solid var(--line); border-radius: 4px;
    box-shadow: 0 2px 6px rgba(14, 26, 43, .06), 0 24px 60px rgba(14, 26, 43, .14);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .sheet:hover { transform: translateY(-2px); box-shadow: 0 2px 6px rgba(14, 26, 43, .06), 0 30px 70px rgba(14, 26, 43, .18); }
  .sheet img { width: 100%; border-radius: 4px; }
  .note { text-align: center; font-size: 13.5px; color: var(--muted); margin: 18px 0 0; }
  @media (max-width: 640px) {
    .head { padding-top: 40px; }
    .actions { width: 100%; }
    .actions .btn { flex: 1; justify-content: center; }
    .viewer { padding: 24px 0 56px; }
  }
</style>
